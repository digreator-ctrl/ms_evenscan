---
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
  currentPath === path
    ? 'text-primary-800 font-bold bg-primary-50 px-3 py-1.5 rounded-lg border border-primary-200/60 shadow-xs'
    : 'text-slate-600 hover:text-primary-800 font-medium px-3 py-1.5 transition-colors';
---

<header class="bg-white border-b border-slate-200/90 sticky top-0 z-50 shadow-xs">
  <div class="max-w-5xl mx-auto px-4 py-2.5 sm:py-3 flex flex-row justify-between items-center gap-3">
    <!-- Brand Info -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group">
      <Logo className="w-8 h-8 sm:w-9 sm:h-9 group-hover:scale-105 transition" />
      <div>
        <div class="inline-block px-1.5 sm:px-2 py-0.5 bg-primary-100 text-primary-800 font-extrabold text-[9px] sm:text-[10px] tracking-wider uppercase rounded-md">
          Muslim Scene
        </div>
        <h1 class="text-sm sm:text-base font-extrabold text-slate-900 tracking-tight leading-none mt-0.5">
          EvenScan <span class="hidden sm:inline">&bull; Registrasi & Absensi</span>
        </h1>
      </div>
    </a>

    <!-- Desktop Navigation Tabs -->
    <nav class="hidden sm:flex items-center gap-1 text-xs">
      <a href="/" class={isActive('/')}>Beranda</a>
      <a href="/daftar" class={isActive('/daftar')}>Daftar</a>
      <a href="/status" class={isActive('/status')}>Cek Status</a>
    </nav>

    <!-- Mobile Quick Action (Ramping & Hemat Ruang) -->
    <div class="flex sm:hidden items-center">
      <a
        href="/status"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary-50 text-primary-800 font-bold text-xs border border-primary-200/80 shadow-xs hover:bg-primary-100 transition active:scale-95"
      >
        <span>🔍</span>
        <span>Cek Status</span>
      </a>
    </div>
  </div>
</header>
