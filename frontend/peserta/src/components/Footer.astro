---
import Logo from './Logo.astro';
---

<footer class="bg-[#05264b] text-white py-12 mt-20 border-t border-[#093e75]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-white/10">
      <div class="flex items-center gap-3.5">
        <Logo variant="white" className="h-10 w-auto" />
        <div>
          <h2 class="font-black text-lg text-white tracking-tight">Muslim Scene Official</h2>
          <p class="text-xs text-sky-200/80">Sistem Registrasi Acara & Tiket Kehadiran Digital</p>
        </div>
      </div>

      <div class="text-center md:text-right text-xs text-white/70">
        <div class="inline-block px-3 py-1 bg-white/10 rounded-lg text-sky-200 font-mono text-[11px] mb-1">
          AHU-0008738.AH.01.04.Tahun 2023
        </div>
        <p>Yayasan Muslim Scene Official Terdaftar di Kemenkumham RI</p>
      </div>
    </div>

    <div class="pt-6 text-center text-xs text-white/50">
      <p>&copy; 2026 Muslim Scene. Hak Cipta Dilindungi Undang-Undang.</p>
    </div>
  </div>
</footer>
