---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
---

<Layout title="Beranda Acara">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-8">
    <!-- Hero Banner Card (Sesuai Desain Referensi) -->
    <section
      class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#06305d] via-[#08407c] to-[#0a529b] text-white p-6 sm:p-12 shadow-xl shadow-slate-900/10"
    >
      <!-- Watermark Logo Background (Mobile & Desktop) -->
      <div
        class="flex absolute -right-6 sm:right-8 top-1/2 -translate-y-1/2 w-48 h-48 sm:w-72 sm:h-72 opacity-15 pointer-events-none select-none items-center justify-center"
      >
        <Logo variant="white" className="w-full h-full object-contain" />
      </div>

      <div class="relative z-10 max-w-2xl">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-white/15 backdrop-blur-sm border border-white/20 text-xs font-bold text-sky-200 mb-4"
        >
          <span>✨</span>
          <span>Portal Pendaftaran Resmi</span>
        </div>

        <h1
          class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-3"
        >
          Muslim Scene
        </h1>

        <p
          class="text-xs sm:text-base text-white/80 leading-relaxed font-normal mb-6 sm:mb-8"
        >
          Sistem pendaftaran kegiatan, registrasi kehadiran digital, dan
          penerbitan tiket QR Code mandiri resmi Muslim Scene.
        </p>

        <!-- Glassmorphism Stat Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3 mb-6 sm:mb-8">
          <div
            class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-3 sm:p-4"
          >
            <div
              class="flex items-center gap-1.5 text-xs text-sky-200 font-medium mb-1"
            >
              <span>👥</span>
              <span>KUOTA ACARA</span>
            </div>
            <div id="kuotaStatus" class="text-xl sm:text-2xl font-black">Terbuka</div>
          </div>

          <div
            class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-3 sm:p-4"
          >
            <div
              class="flex items-center gap-1.5 text-xs text-sky-200 font-medium mb-1"
            >
              <span>⚡</span>
              <span>TIKET QR</span>
            </div>
            <div class="text-xl sm:text-2xl font-black">Instan</div>
          </div>

          <div
            class="col-span-2 sm:col-span-1 bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-3 sm:p-4"
          >
            <div
              class="flex items-center gap-1.5 text-xs text-sky-200 font-medium mb-1"
            >
              <span>📱</span>
              <span>NOTIFIKASI</span>
            </div>
            <div class="text-xl sm:text-2xl font-black">WhatsApp</div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-2.5 sm:gap-3 pt-1">
          <a
            id="btnDaftar"
            href="/daftar"
            class="bg-white hover:bg-sky-50 text-[#07407b] font-black px-5 py-3 sm:px-6 sm:py-3.5 rounded-xl transition duration-150 shadow-md text-xs sm:text-sm flex items-center justify-center gap-2"
          >
            <span id="btnDaftarText">Daftar Sekarang</span>
            <span id="btnDaftarIcon">→</span>
          </a>
          <a
            href="/status"
            class="bg-sky-400/20 hover:bg-sky-400/30 text-white font-bold px-5 py-3 sm:px-6 sm:py-3.5 rounded-xl transition duration-150 border border-white/20 text-xs sm:text-sm flex items-center justify-center gap-2"
          >
            <span>🔍</span>
            <span>Cek Status & Tiket QR</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Bar Informasi Legalitas & Profil (Sesuai Referensi Gambar) -->
    <section class="grid sm:grid-cols-2 gap-4">
      <div
        class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs flex items-center gap-4"
      >
        <div
          class="w-12 h-12 rounded-xl bg-primary-50 text-primary-700 flex items-center justify-center text-xl font-bold"
        >
          🏛️
        </div>
        <div>
          <div
            class="inline-block px-2 py-0.5 bg-slate-100 text-slate-700 font-extrabold text-[10px] uppercase rounded tracking-wider"
          >
            Profil Yayasan
          </div>
          <h2 class="text-sm font-bold text-slate-900 mt-0.5">
            Muslim Scene Official
          </h2>
          <p class="text-xs text-slate-500">
            Menebar kebaikan & dakwah kreatif untuk generasi muda.
          </p>
        </div>
      </div>

      <div
        class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs flex items-center gap-4"
      >
        <div
          class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl font-bold"
        >
          🛡️
        </div>
        <div>
          <div
            class="inline-block px-2 py-0.5 bg-emerald-100 text-emerald-800 font-extrabold text-[10px] uppercase rounded tracking-wider"
          >
            Legalitas Resmi Kemenkumham
          </div>
          <h2 class="text-sm font-bold text-slate-900 mt-0.5">
            AHU-0008738.AH.01.04.Tahun 2023
          </h2>
          <p class="text-xs text-slate-500">
            Terdaftar dan beroperasi secara legal & akuntabel.
          </p>
        </div>
      </div>
    </section>

    <!-- 4 Langkah Alur Pendaftaran -->
    <section
      class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs space-y-6"
    >
      <div class="border-b border-slate-100 pb-4">
        <div
          class="inline-block px-2.5 py-1 bg-sky-100 text-primary-800 font-extrabold text-xs uppercase tracking-wider rounded-md mb-1"
        >
          Panduan Registrasi
        </div>
        <h2 class="text-xl font-extrabold text-slate-900">
          Alur Pendaftaran & Tiket Kehadiran
        </h2>
      </div>

      <div class="grid sm:grid-cols-4 gap-4">
        <div
          class="bg-slate-50/80 rounded-2xl p-5 border border-slate-200/80 space-y-2"
        >
          <div
            class="w-8 h-8 rounded-lg bg-primary-700 text-white font-black text-xs flex items-center justify-center"
          >
            1
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Isi Biodata</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Lengkapi nama lengkap dan nomor WhatsApp aktif Anda.
          </p>
        </div>

        <div
          class="bg-slate-50/80 rounded-2xl p-5 border border-slate-200/80 space-y-2"
        >
          <div
            class="w-8 h-8 rounded-lg bg-primary-700 text-white font-black text-xs flex items-center justify-center"
          >
            2
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Unggah Foto</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Upload tangkapan layar bukti persyaratan (kompresi otomatis).
          </p>
        </div>

        <div
          class="bg-slate-50/80 rounded-2xl p-5 border border-slate-200/80 space-y-2"
        >
          <div
            class="w-8 h-8 rounded-lg bg-primary-700 text-white font-black text-xs flex items-center justify-center"
          >
            3
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Verifikasi Panitia</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Panitia menyetujui berkas melalui panel admin khusus.
          </p>
        </div>

        <div
          class="bg-slate-50/80 rounded-2xl p-5 border border-slate-200/80 space-y-2"
        >
          <div
            class="w-8 h-8 rounded-lg bg-emerald-600 text-white font-black text-xs flex items-center justify-center"
          >
            4
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Scan di Lokasi</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Tunjukkan QR Code di meja registrasi pada hari acara.
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- Modal Popup Permintaan Maaf: Pendaftaran Telah Ditutup -->
  <div
    id="modalKuotaTutup"
    class="hidden fixed inset-0 z-50 items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalKuotaTutupTitle"
  >
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-slate-100 text-center">
      <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 border border-rose-200 flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          ></path>
        </svg>
      </div>

      <h3 id="modalKuotaTutupTitle" class="text-base font-black text-slate-900 mb-1.5">
        Mohon Maaf, Pendaftaran Telah Ditutup
      </h3>
      <p class="text-xs text-slate-500 leading-relaxed mb-6">
        Kuota acara saat ini sudah terpenuhi sehingga pendaftaran peserta ditutup untuk sementara. Silakan pantau kembali portal resmi Muslim Scene untuk informasi pembukaan kuota berikutnya.
      </p>

      <button
        id="btnTutupModal"
        type="button"
        class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition shadow-sm active:scale-95 cursor-pointer"
      >
        Mengerti
      </button>
    </div>
  </div>

  <script>
    let isBuka = true;

    function showModalKuotaTutup() {
      const modal = document.getElementById('modalKuotaTutup');
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function hideModalKuotaTutup() {
      const modal = document.getElementById('modalKuotaTutup');
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function updateKuotaStatus() {
      const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
      const kuotaEl = document.getElementById('kuotaStatus');
      const btnDaftar = document.getElementById('btnDaftar') as HTMLAnchorElement | null;
      const btnText = document.getElementById('btnDaftarText');
      const btnIcon = document.getElementById('btnDaftarIcon');

      if (!kuotaEl || !btnDaftar) return;

      fetch(`${API_URL}/api/peserta/config`)
        .then((res) => {
          if (!res.ok) throw new Error('Network error');
          return res.json();
        })
        .then((data: any) => {
          isBuka = data.pendaftaran_buka ?? true;
          if (!isBuka) {
            kuotaEl.textContent = 'Ditutup';
            kuotaEl.classList.add('text-amber-300');
            if (btnText) btnText.textContent = 'Kuota Acara Ditutup';
            if (btnIcon) btnIcon.textContent = '🔒';
            btnDaftar.removeAttribute('href');
            btnDaftar.classList.remove('bg-white', 'hover:bg-sky-50', 'text-[#07407b]', 'shadow-md');
            btnDaftar.classList.add('bg-white/20', 'text-white/60', 'border', 'border-white/15', 'cursor-pointer');
          } else {
            kuotaEl.textContent = 'Terbuka';
            kuotaEl.classList.remove('text-amber-300');
            if (btnText) btnText.textContent = 'Daftar Sekarang';
            if (btnIcon) btnIcon.textContent = '→';
            btnDaftar.setAttribute('href', '/daftar');
            btnDaftar.classList.remove('bg-white/20', 'text-white/60', 'border', 'border-white/15', 'cursor-pointer');
            btnDaftar.classList.add('bg-white', 'hover:bg-sky-50', 'text-[#07407b]', 'shadow-md');
          }
        })
        .catch((err) => {
          console.warn('Gagal memuat status kuota:', err);
        });
    }

    // Delegasi event klik (terdaftar sekali di scope module agar tidak terjadi duplikasi listener)
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      if (target.closest('#btnDaftar')) {
        if (!isBuka) {
          e.preventDefault();
          showModalKuotaTutup();
        }
        return;
      }

      if (target.closest('#btnTutupModal')) {
        hideModalKuotaTutup();
        return;
      }

      if (target.id === 'modalKuotaTutup') {
        hideModalKuotaTutup();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        hideModalKuotaTutup();
      }
    });

    document.addEventListener('astro:page-load', updateKuotaStatus);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateKuotaStatus);
    } else {
      updateKuotaStatus();
    }
  </script>
</Layout>
