---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cek Status Pendaftaran & Tiket QR - Muslim Scene">
  <section class="py-12 sm:py-16">
    <div class="max-w-xl mx-auto px-4">
      <!-- Section Header -->
      <div class="text-center mb-8">
        <span class="inline-block px-3 py-1 bg-primary-100 text-primary-800 text-xs font-bold rounded-full uppercase tracking-wider mb-2">
          Portal Peserta
        </span>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Cek Status & Tiket QR</h1>
        <p class="text-sm text-slate-500 mt-2 max-w-md mx-auto">
          Periksa status verifikasi pendaftaran Anda dan unduh tiket QR Code kehadiran untuk ditunjukkan saat acara.
        </p>
      </div>

      <!-- Pop-up Toast Alert -->
      <div
        id="toastAlert"
        class="fixed top-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-slate-900/95 text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-slate-700/80 backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none -translate-y-4 max-w-sm w-[90%]"
        role="alert"
        aria-live="assertive"
      >
        <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 text-base font-bold">
          ⚠️
        </div>
        <div class="flex-1">
          <p class="text-xs font-bold text-white" id="toastTitle">Kolom Belum Terisi</p>
          <p class="text-[11px] text-slate-300 mt-0.5 leading-snug" id="toastMessage">Harap masukkan kode akses tiket Anda.</p>
        </div>
      </div>

      <!-- Search Card: 1 Kolom Kode Akses (NIP + 4 Digit Terakhir No WA) -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 sm:p-6 mb-6">
        <form id="formStatus" novalidate class="space-y-4">
          <div>
            <label for="inputKode" class="block text-xs font-bold text-slate-700 mb-1.5">
              Kode Akses Tiket (NIP + 4 Digit Terakhir No. WhatsApp)
            </label>
            <input
              type="text"
              id="inputKode"
              placeholder="Contoh: ARN212-000017890"
              required
              class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition uppercase font-mono tracking-wide"
            />
            <p class="text-[11px] text-slate-400 mt-1.5 flex items-center gap-1">
              <span>💡</span>
              <span>Masukkan kode akses yang tercantum pada pesan WhatsApp konfirmasi dari panitia.</span>
            </p>
          </div>

          <button
            type="submit"
            id="btnCari"
            class="w-full bg-primary-600 hover:bg-primary-700 active:scale-[0.99] text-white font-bold px-6 py-3.5 rounded-xl transition duration-150 text-sm shadow-md shadow-primary-600/20 flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Periksa Status Kehadiran</span>
          </button>
        </form>
      </div>

      <!-- Loading State -->
      <div id="loading" class="hidden text-center py-10 space-y-3">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-3 border-primary-600 border-t-transparent"></div>
        <p class="text-sm font-medium text-slate-500">Mencari data pendaftaran...</p>
      </div>

      <!-- Result 1: Status Menunggu Verifikasi -->
      <div id="resultMenunggu" class="hidden bg-amber-50/80 border border-amber-200 rounded-3xl p-6 sm:p-8 text-center space-y-3">
        <div class="w-16 h-16 bg-amber-100 text-amber-700 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
          ⏳
        </div>
        <h2 class="text-xl font-bold text-amber-900">Menunggu Verifikasi Panitia</h2>
        <p class="text-sm text-amber-800/80 max-w-sm mx-auto leading-relaxed">
          Pendaftaran Anda atas nama <strong id="namaMenunggu" class="text-amber-950"></strong> sudah masuk. Mohon tunggu, panitia sedang memeriksa bukti tangkapan layar Anda.
        </p>
        <div class="pt-2">
          <span class="inline-block px-3 py-1 bg-amber-200/70 text-amber-900 rounded-full text-xs font-semibold">
            Status: Menunggu Konfirmasi
          </span>
        </div>
      </div>

      <!-- Result 2: Status Dikonfirmasi (Kartu Hijau Lengkap) -->
      <div id="resultDikonfirmasi" class="hidden space-y-4">
        <!-- Kotak Penuh Desain Tiket Hijau -->
        <div id="ticketCard" class="bg-emerald-50/90 border-2 border-emerald-300 rounded-3xl p-6 sm:p-8 text-center space-y-4 shadow-sm">
          <div class="w-14 h-14 bg-emerald-100 text-emerald-700 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold shadow-xs border border-emerald-200">
            ✓
          </div>
          <div>
            <span class="inline-block px-3 py-1 bg-emerald-200/80 text-emerald-900 rounded-full text-xs font-bold uppercase tracking-wider mb-2">
              Terverifikasi & Diterima
            </span>
            <h2 class="text-2xl font-black text-slate-900">Tiket QR Code Kehadiran</h2>
            <p class="text-xs font-bold text-emerald-700 tracking-wide mt-0.5">Muslim Scene Event</p>
            <p id="pesertaNama" class="text-lg font-bold text-emerald-950 mt-2"></p>
            <p id="pesertaInstansi" class="text-xs text-slate-600 mt-0.5"></p>
          </div>

          <!-- Frame Gambar QR Code Putih di Tengah -->
          <div class="bg-white p-5 rounded-2xl inline-block shadow-sm border border-emerald-200/80 my-2">
            <img id="qrImage" class="w-60 h-60 mx-auto rounded-lg object-contain" alt="QR Code Kehadiran" />
            <p class="text-xs text-slate-500 mt-2 font-mono font-bold" id="qrTokenDisplay"></p>
          </div>

          <p class="text-xs text-slate-600 max-w-sm mx-auto leading-relaxed">
            ⚠️ Simpan atau screenshot QR Code ini. Tunjukkan ke panitia di meja registrasi pada hari acara untuk dipindai.
          </p>
        </div>

        <!-- Tombol Download Tiket Lengkap -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center pt-1">
          <button
            id="downloadQR"
            type="button"
            class="bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold px-6 py-3.5 rounded-xl transition duration-150 text-sm shadow-md shadow-emerald-600/20 flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>📥</span>
            <span id="downloadBtnText">Unduh Gambar Tiket Lengkap</span>
          </button>
        </div>
      </div>

      <!-- Result 3: Status Sudah Hadir -->
      <div id="resultHadir" class="hidden bg-blue-50/80 border border-blue-200 rounded-3xl p-6 sm:p-8 text-center space-y-4">
        <div class="w-16 h-16 bg-blue-100 text-blue-700 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
          🎉
        </div>
        <h2 class="text-2xl font-black text-blue-900">Anda Sudah Tercatat Hadir!</h2>
        <p id="namaHadir" class="text-sm font-bold text-blue-900"></p>
        <p class="text-xs text-blue-700 max-w-sm mx-auto leading-relaxed">
          Absensi kehadiran Anda di lokasi acara telah berhasil divalidasi oleh panitia. Selamat mengikuti rangkaian acara!
        </p>
      </div>

      <!-- Result 4: Status Ditolak -->
      <div id="resultDitolak" class="hidden bg-rose-50/80 border border-rose-200 rounded-3xl p-6 sm:p-8 text-center space-y-3">
        <div class="w-16 h-16 bg-rose-100 text-rose-700 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
          ✕
        </div>
        <h2 class="text-xl font-bold text-rose-900">Pendaftaran Ditolak</h2>
        <p class="text-sm text-rose-800/80 max-w-sm mx-auto">
          Mohon maaf, pendaftaran Anda tidak dapat disetujui oleh panitia.
        </p>
        <div id="boxAlasan" class="bg-white/80 border border-rose-200/80 rounded-xl p-3 text-xs text-rose-700 font-medium max-w-sm mx-auto">
          <span id="alasanTolak"></span>
        </div>
      </div>

      <!-- Result 5: Tidak Ditemukan -->
      <div id="resultNotFound" class="hidden bg-slate-100/90 border border-slate-200 rounded-3xl p-6 sm:p-8 text-center space-y-3">
        <div class="w-16 h-16 bg-slate-200 text-slate-500 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
          🔍
        </div>
        <h2 class="text-lg font-bold text-slate-800">Data Tidak Ditemukan</h2>
        <p class="text-xs text-slate-500 max-w-xs mx-auto">
          Data pendaftar dengan kode akses tersebut tidak ditemukan. Pastikan kode akses yang dimasukkan sesuai dengan pesan WhatsApp dari panitia.
        </p>
        <div class="pt-2">
          <a href="/daftar" class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition">
            Daftar Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    function initStatusPage() {
      const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

      const form = document.getElementById('formStatus') as HTMLFormElement | null;
      const inputKode = document.getElementById('inputKode') as HTMLInputElement | null;
      const loading = document.getElementById('loading');
      const toast = document.getElementById('toastAlert');
      const toastTitle = document.getElementById('toastTitle');
      const toastMessage = document.getElementById('toastMessage');

      const resultMenunggu = document.getElementById('resultMenunggu');
      const resultDikonfirmasi = document.getElementById('resultDikonfirmasi');
      const resultDitolak = document.getElementById('resultDitolak');
      const resultHadir = document.getElementById('resultHadir');
      const resultNotFound = document.getElementById('resultNotFound');

      const namaMenunggu = document.getElementById('namaMenunggu');
      const pesertaNama = document.getElementById('pesertaNama');
      const pesertaInstansi = document.getElementById('pesertaInstansi');
      const qrImage = document.getElementById('qrImage') as HTMLImageElement | null;
      const qrTokenDisplay = document.getElementById('qrTokenDisplay');
      const namaHadir = document.getElementById('namaHadir');
      const alasanTolak = document.getElementById('alasanTolak');
      const downloadQR = document.getElementById('downloadQR');
      const downloadBtnText = document.getElementById('downloadBtnText');

      if (!form || !inputKode || !loading) return;

      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      function showToast(message = 'Harap lengkapi data periksa.', title = 'Kolom Belum Terisi', targetInput?: HTMLInputElement | null) {
        if (!toast) return;
        if (toastTitle) toastTitle.textContent = title;
        if (toastMessage) toastMessage.textContent = message;

        toast.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');

        const el = targetInput || inputKode;
        if (el) {
          el.classList.add('border-amber-500', 'ring-2', 'ring-amber-500/30');
          el.focus();
        }

        if (toastTimer) clearTimeout(toastTimer);

        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
          inputKode?.classList.remove('border-amber-500', 'ring-2', 'ring-amber-500/30');
        }, 3000);
      }

      function hideAll() {
        [resultMenunggu, resultDikonfirmasi, resultDitolak, resultHadir, resultNotFound].forEach((el) =>
          el?.classList.add('hidden')
        );
      }

      async function checkStatus(nipParam = '', wa4Param = '', waFullParam = '', kodeParam = '') {
        if (!nipParam && !wa4Param && !waFullParam && !kodeParam) return;
        hideAll();
        loading?.classList.remove('hidden');

        try {
          let url = `${API_URL}/api/peserta/status`;
          if (kodeParam) {
            url += `?kode=${encodeURIComponent(kodeParam)}`;
          } else if (nipParam && wa4Param) {
            url += `?nip=${encodeURIComponent(nipParam)}&wa4=${encodeURIComponent(wa4Param)}`;
          } else if (waFullParam) {
            url += `?wa=${encodeURIComponent(waFullParam)}`;
          }

          const res = await fetch(url);
          loading?.classList.add('hidden');

          if (res.status === 404) {
            resultNotFound?.classList.remove('hidden');
            return;
          }

          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            showToast(errData.error || 'Gagal memeriksa status kehadiran', 'Pemeriksaan Gagal');
            resultNotFound?.classList.remove('hidden');
            return;
          }

          const data = await res.json();

          switch (data.status) {
            case 'menunggu':
              if (namaMenunggu) namaMenunggu.textContent = data.nama;
              resultMenunggu?.classList.remove('hidden');
              break;
            case 'dikonfirmasi':
              if (pesertaNama) pesertaNama.textContent = data.nama;
              if (pesertaInstansi) pesertaInstansi.textContent = data.instansi ? `Asal: ${data.instansi}` : '';
              if (qrImage) {
                qrImage.src = `${API_URL}/api/peserta/qr/${data.qr_token}`;
              }
              if (qrTokenDisplay) qrTokenDisplay.textContent = `Token: ${data.qr_token}`;
              resultDikonfirmasi?.classList.remove('hidden');
              break;
            case 'hadir':
              if (namaHadir) namaHadir.textContent = data.nama;
              resultHadir?.classList.remove('hidden');
              break;
            case 'ditolak':
              if (alasanTolak) alasanTolak.textContent = data.alasan_tolak ? `Catatan: ${data.alasan_tolak}` : 'Tidak memenuhi kualifikasi';
              resultDitolak?.classList.remove('hidden');
              break;
            default:
              resultNotFound?.classList.remove('hidden');
          }
        } catch (err) {
          loading?.classList.add('hidden');
          resultNotFound?.classList.remove('hidden');
        }
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const rawKode = inputKode.value.trim();
        const cleanKode = rawKode.replace(/[()]/g, '').trim();

        if (!cleanKode) {
          showToast('Harap masukkan kode akses tiket Anda terlebih dahulu.', 'Kode Akses Wajib Diisi', inputKode);
          return;
        }

        if (cleanKode.length < 5) {
          showToast('Kode akses harus berisi gabungan NIP dan 4 digit terakhir nomor WhatsApp.', 'Format Kode Tidak Sesuai', inputKode);
          return;
        }

        const wa4Val = cleanKode.slice(-4);
        const nipVal = cleanKode.slice(0, -4).trim();

        // Update URL tanpa reload
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('kode', cleanKode);
        newUrl.searchParams.delete('nip');
        newUrl.searchParams.delete('wa4');
        newUrl.searchParams.delete('wa');
        window.history.pushState({}, '', newUrl.toString());

        checkStatus(nipVal, wa4Val, '', cleanKode);
      });

      // Generator Gambar Tiket Lengkap (Desain Kotak Penuh Kartu Hijau)
      async function generateFullTicketBlob(): Promise<Blob> {
        const canvas = document.createElement('canvas');
        const width = 800;
        const height = 1040;
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        if (!ctx) throw new Error('Canvas 2D tidak tersedia');

        // Background putih kanvas luar
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, width, height);

        // Card background hijau lembut (#f0fdf4)
        const margin = 24;
        const cardW = width - margin * 2;
        const cardH = height - margin * 2;
        const cardRadius = 36;

        ctx.save();
        ctx.beginPath();
        if (ctx.roundRect) {
          ctx.roundRect(margin, margin, cardW, cardH, cardRadius);
        } else {
          ctx.rect(margin, margin, cardW, cardH);
        }
        ctx.fillStyle = '#f0fdf4'; // emerald-50
        ctx.fill();
        ctx.lineWidth = 4;
        ctx.strokeStyle = '#86efac'; // emerald-300
        ctx.stroke();
        ctx.restore();

        // 1. Icon Box Centang Hijau
        const iconSize = 70;
        const iconX = width / 2 - iconSize / 2;
        const iconY = 65;
        ctx.save();
        ctx.beginPath();
        if (ctx.roundRect) {
          ctx.roundRect(iconX, iconY, iconSize, iconSize, 20);
        } else {
          ctx.rect(iconX, iconY, iconSize, iconSize);
        }
        ctx.fillStyle = '#d1fae5'; // emerald-100
        ctx.fill();
        ctx.lineWidth = 2;
        ctx.strokeStyle = '#a7f3d0';
        ctx.stroke();

        ctx.fillStyle = '#059669'; // emerald-600
        ctx.font = 'bold 36px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('✓', width / 2, iconY + iconSize / 2);
        ctx.restore();

        // 2. Badge Status: "TERVERIFIKASI & DITERIMA"
        const badgeY = 160;
        const badgeW = 240;
        const badgeH = 34;
        ctx.save();
        ctx.beginPath();
        if (ctx.roundRect) {
          ctx.roundRect(width / 2 - badgeW / 2, badgeY, badgeW, badgeH, 17);
        } else {
          ctx.rect(width / 2 - badgeW / 2, badgeY, badgeW, badgeH);
        }
        ctx.fillStyle = '#d1fae5';
        ctx.fill();
        ctx.fillStyle = '#065f46';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('TERVERIFIKASI & DITERIMA', width / 2, badgeY + badgeH / 2);
        ctx.restore();

        // 3. Judul: "Tiket QR Code Kehadiran" & Acara
        ctx.fillStyle = '#0f172a'; // slate-900
        ctx.font = '900 28px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'alphabetic';
        ctx.fillText('Tiket QR Code Kehadiran', width / 2, 230);

        ctx.fillStyle = '#059669'; // emerald-600
        ctx.font = 'bold 14px sans-serif';
        ctx.fillText('Muslim Scene Event', width / 2, 256);

        // 4. Nama Peserta & Asal/Instansi
        const nama = pesertaNama?.textContent || 'Peserta';
        const instansi = pesertaInstansi?.textContent || '';
        ctx.fillStyle = '#064e3b'; // emerald-950
        ctx.font = 'bold 22px sans-serif';
        ctx.fillText(nama, width / 2, 292);

        if (instansi) {
          ctx.fillStyle = '#64748b'; // slate-500
          ctx.font = '14px sans-serif';
          ctx.fillText(instansi, width / 2, 318);
        }

        // 5. White Box Frame untuk QR Code
        const qrBoxW = 420;
        const qrBoxH = 450;
        const qrBoxX = width / 2 - qrBoxW / 2;
        const qrBoxY = instansi ? 335 : 320;
        ctx.save();
        ctx.beginPath();
        if (ctx.roundRect) {
          ctx.roundRect(qrBoxX, qrBoxY, qrBoxW, qrBoxH, 24);
        } else {
          ctx.rect(qrBoxX, qrBoxY, qrBoxW, qrBoxH);
        }
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.lineWidth = 2;
        ctx.strokeStyle = '#e2e8f0';
        ctx.stroke();
        ctx.restore();

        // 6. Draw QR Code Image via local blob URL
        if (qrImage && qrImage.src) {
          const res = await fetch(qrImage.src);
          const blob = await res.blob();
          const blobUrl = URL.createObjectURL(blob);
          const img = new Image();
          img.src = blobUrl;
          await new Promise((resolve, reject) => {
            img.onload = resolve;
            img.onerror = reject;
          });

          const qrDrawSize = 330;
          const qrDrawX = width / 2 - qrDrawSize / 2;
          const qrDrawY = qrBoxY + 30;
          ctx.drawImage(img, qrDrawX, qrDrawY, qrDrawSize, qrDrawSize);
          URL.revokeObjectURL(blobUrl);
        }

        // Token QR Text
        const tokenText = qrTokenDisplay?.textContent || '';
        ctx.fillStyle = '#64748b';
        ctx.font = 'bold 14px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(tokenText, width / 2, qrBoxY + qrBoxH - 35);

        // 7. Advisory Text
        const noticeY = qrBoxY + qrBoxH + 42;
        ctx.fillStyle = '#475569';
        ctx.font = '13px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('⚠️ Simpan atau screenshot QR Code ini. Tunjukkan ke panitia', width / 2, noticeY);
        ctx.fillText('di meja registrasi pada hari acara untuk dipindai.', width / 2, noticeY + 22);

        // 8. Footer Branding
        ctx.fillStyle = '#06305d';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText('Muslim Scene • EvenScan System', width / 2, height - margin - 18);

        return new Promise((resolve, reject) => {
          canvas.toBlob((b) => {
            if (b) resolve(b);
            else reject(new Error('Gagal mengekspor blob kanvas'));
          }, 'image/png');
        });
      }

      downloadQR?.addEventListener('click', async () => {
        if (!qrImage || !qrImage.src) return;
        try {
          if (downloadBtnText) downloadBtnText.textContent = 'Membuat Gambar Tiket...';
          downloadQR.setAttribute('disabled', 'true');

          const blob = await generateFullTicketBlob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          const namaFile = pesertaNama?.textContent?.replace(/\s+/g, '-').toLowerCase() || 'kehadiran';
          a.download = `tiket-lengkap-${namaFile}.png`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          window.URL.revokeObjectURL(url);
        } catch (err: any) {
          console.error('Download ticket error:', err);
          showToast('Gagal memproses gambar tiket lengkap, mencoba unduh QR langsung.', 'Gagal Buat Tiket');
          window.open(qrImage.src, '_blank');
        } finally {
          if (downloadBtnText) downloadBtnText.textContent = 'Unduh Gambar Tiket Lengkap';
          downloadQR?.removeAttribute('disabled');
        }
      });

      // Auto-search jika ada parameter di URL
      const urlParams = new URLSearchParams(window.location.search);
      const kodeParam = urlParams.get('kode');
      const nipParam = urlParams.get('nip');
      const wa4Param = urlParams.get('wa4');
      const waParam = urlParams.get('wa');

      if (kodeParam) {
        inputKode.value = kodeParam;
        const clean = kodeParam.replace(/[()]/g, '').trim();
        checkStatus(clean.slice(0, -4), clean.slice(-4), '', clean);
      } else if (nipParam && wa4Param) {
        const combined = `${nipParam}${wa4Param}`;
        inputKode.value = combined;
        checkStatus(nipParam, wa4Param, '', combined);
      } else if (waParam) {
        checkStatus('', '', waParam);
      }
    }

    document.addEventListener('astro:page-load', initStatusPage);
  </script>
</Layout>
