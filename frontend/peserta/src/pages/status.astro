---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cek Status Pendaftaran & QR Code">
  <section class="py-12 px-4">
    <div class="max-w-lg mx-auto">
      <div class="text-center mb-8">
        <span class="inline-block px-3 py-1 bg-primary-100 text-primary-800 rounded-full text-xs font-semibold uppercase tracking-wider mb-2">
          Self-Service Mandiri
        </span>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Cek Status Kehadiran</h1>
        <p class="text-slate-500 text-sm mt-1 max-w-sm mx-auto">
          Masukkan nomor WhatsApp terdaftar untuk melihat status dan mengunduh QR Code Anda.
        </p>
      </div>

      <!-- Floating Toast / Notification Popup (Auto-Dismiss) -->
      <div
        id="toastAlert"
        class="fixed top-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-slate-900/95 text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-slate-700/80 backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none -translate-y-4 max-w-sm w-[90%]"
        role="alert"
        aria-live="assertive"
      >
        <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 text-base font-bold">
          ⚠️
        </div>
        <div class="flex-1">
          <p class="text-xs font-bold text-white" id="toastTitle">Kolom Belum Terisi</p>
          <p class="text-[11px] text-slate-300 mt-0.5 leading-snug" id="toastMessage">Harap masukkan nomor WhatsApp Anda terlebih dahulu.</p>
        </div>
      </div>

      <!-- Search Card -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 sm:p-6 mb-6">
        <form id="formStatus" novalidate class="flex flex-col sm:flex-row gap-2.5">
          <input
            type="tel"
            id="inputWA"
            placeholder="Contoh: 081234567890"
            required
            class="flex-1 border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition"
          />
          <button
            type="submit"
            id="btnCari"
            class="bg-primary-600 hover:bg-primary-700 active:scale-[0.99] text-white font-bold px-6 py-3 rounded-xl transition duration-150 text-sm shadow-md shadow-primary-600/20 whitespace-nowrap"
          >
            Periksa Status
          </button>
        </form>
      </div>

      <!-- Loading State -->
      <div id="loading" class="hidden text-center py-10 space-y-3">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-3 border-primary-600 border-t-transparent"></div>
        <p class="text-sm font-medium text-slate-500">Mencari data pendaftaran...</p>
      </div>

      <!-- Result 1: Status Menunggu Verifikasi -->
      <div id="resultMenunggu" class="hidden bg-amber-50/80 border border-amber-200 rounded-3xl p-6 sm:p-8 text-center space-y-3">
        <div class="w-16 h-16 bg-amber-100 text-amber-700 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
          ⏳
        </div>
        <h2 class="text-xl font-bold text-amber-900">Menunggu Verifikasi Panitia</h2>
        <p class="text-sm text-amber-800/80 max-w-sm mx-auto leading-relaxed">
          Pendaftaran Anda atas nama <strong id="namaMenunggu" class="text-amber-950"></strong> sudah masuk. Mohon tunggu, panitia sedang memeriksa bukti tangkapan layar Anda.
        </p>
        <div class="pt-2">
          <span class="inline-block px-3 py-1 bg-amber-200/70 text-amber-900 rounded-full text-xs font-semibold">
            Status: Menunggu Konfirmasi
          </span>
        </div>
      </div>

      <!-- Result 2: Status Dikonfirmasi (QR Code Tersedia) -->
      <div id="resultDikonfirmasi" class="hidden bg-emerald-50/80 border border-emerald-200 rounded-3xl p-6 sm:p-8 text-center space-y-5">
        <div class="w-14 h-14 bg-emerald-100 text-emerald-700 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
          ✓
        </div>
        <div>
          <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-semibold uppercase tracking-wider mb-2">
            Terverifikasi & Diterima
          </span>
          <h2 class="text-2xl font-black text-slate-900">Tiket QR Code Kehadiran</h2>
          <p id="pesertaNama" class="text-sm font-bold text-emerald-800 mt-1"></p>
          <p id="pesertaInstansi" class="text-xs text-slate-500"></p>
        </div>

        <!-- Frame Gambar QR Code -->
        <div class="bg-white p-5 rounded-2xl inline-block shadow-sm border border-emerald-100">
          <img id="qrImage" class="w-60 h-60 mx-auto rounded-lg object-contain" alt="QR Code Kehadiran" />
          <p class="text-[11px] text-slate-400 mt-2 font-mono" id="qrTokenDisplay"></p>
        </div>

        <p class="text-xs text-slate-600 max-w-sm mx-auto">
          ⚠️ Simpan atau screenshot QR Code ini. Tunjukkan ke panitia di meja registrasi pada hari acara untuk dipindai.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
          <button
            id="downloadQR"
            type="button"
            class="bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold px-6 py-3 rounded-xl transition duration-150 text-sm shadow-md shadow-emerald-600/20 flex items-center justify-center gap-2"
          >
            <span>📥</span>
            <span>Unduh Gambar QR Code</span>
          </button>
        </div>
      </div>

      <!-- Result 3: Status Sudah Hadir -->
      <div id="resultHadir" class="hidden bg-blue-50/80 border border-blue-200 rounded-3xl p-6 sm:p-8 text-center space-y-4">
        <div class="w-16 h-16 bg-blue-100 text-blue-700 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
          🎉
        </div>
        <h2 class="text-2xl font-black text-blue-900">Anda Sudah Tercatat Hadir!</h2>
        <p id="namaHadir" class="text-sm font-bold text-blue-900"></p>
        <p class="text-xs text-blue-700 max-w-sm mx-auto leading-relaxed">
          Absensi kehadiran Anda di lokasi acara telah berhasil divalidasi oleh panitia. Selamat mengikuti rangkaian acara!
        </p>
      </div>

      <!-- Result 4: Status Ditolak -->
      <div id="resultDitolak" class="hidden bg-rose-50/80 border border-rose-200 rounded-3xl p-6 sm:p-8 text-center space-y-3">
        <div class="w-16 h-16 bg-rose-100 text-rose-700 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
          ✕
        </div>
        <h2 class="text-xl font-bold text-rose-900">Pendaftaran Ditolak</h2>
        <p class="text-sm text-rose-800/80 max-w-sm mx-auto">
          Mohon maaf, pendaftaran Anda tidak dapat disetujui oleh panitia.
        </p>
        <div id="boxAlasan" class="bg-white/80 border border-rose-200/80 rounded-xl p-3 text-xs text-rose-700 font-medium max-w-sm mx-auto">
          <span id="alasanTolak"></span>
        </div>
      </div>

      <!-- Result 5: Tidak Ditemukan -->
      <div id="resultNotFound" class="hidden bg-slate-100/90 border border-slate-200 rounded-3xl p-6 sm:p-8 text-center space-y-3">
        <div class="w-16 h-16 bg-slate-200 text-slate-500 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
          🔍
        </div>
        <h2 class="text-lg font-bold text-slate-800">Nomor Tidak Ditemukan</h2>
        <p class="text-xs text-slate-500 max-w-xs mx-auto">
          Nomor WhatsApp tersebut belum terdaftar di sistem. Pastikan Anda memasukkan nomor yang sesuai saat pengisian formulir.
        </p>
        <div class="pt-2">
          <a href="/daftar" class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition">
            Daftar Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    function initStatusPage() {
      const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

      const form = document.getElementById('formStatus') as HTMLFormElement | null;
      const inputWA = document.getElementById('inputWA') as HTMLInputElement | null;
      const loading = document.getElementById('loading');
      const toast = document.getElementById('toastAlert');
      const toastTitle = document.getElementById('toastTitle');
      const toastMessage = document.getElementById('toastMessage');

      const resultMenunggu = document.getElementById('resultMenunggu');
      const resultDikonfirmasi = document.getElementById('resultDikonfirmasi');
      const resultDitolak = document.getElementById('resultDitolak');
      const resultHadir = document.getElementById('resultHadir');
      const resultNotFound = document.getElementById('resultNotFound');

      const namaMenunggu = document.getElementById('namaMenunggu');
      const pesertaNama = document.getElementById('pesertaNama');
      const pesertaInstansi = document.getElementById('pesertaInstansi');
      const qrImage = document.getElementById('qrImage') as HTMLImageElement | null;
      const qrTokenDisplay = document.getElementById('qrTokenDisplay');
      const namaHadir = document.getElementById('namaHadir');
      const alasanTolak = document.getElementById('alasanTolak');
      const downloadQR = document.getElementById('downloadQR');

      if (!form || !inputWA || !loading) return;

      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      function showToast(message = 'Harap masukkan nomor WhatsApp Anda terlebih dahulu.', title = 'Kolom Belum Terisi') {
        if (!toast) return;
        if (toastTitle) toastTitle.textContent = title;
        if (toastMessage) toastMessage.textContent = message;

        // Tampilkan pop up / modal notifikasi
        toast.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');

        // Highlight input
        if (inputWA) {
          inputWA.classList.add('border-amber-500', 'ring-2', 'ring-amber-500/30');
          inputWA.focus();
        }

        // Hapus timer sebelumnya jika tombol diklik berulang kali
        if (toastTimer) clearTimeout(toastTimer);

        // Pop up menghilang dengan sendirinya setelah 3 detik
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
          if (inputWA) {
            inputWA.classList.remove('border-amber-500', 'ring-2', 'ring-amber-500/30');
          }
        }, 3000);
      }

      function hideAll() {
        [resultMenunggu, resultDikonfirmasi, resultDitolak, resultHadir, resultNotFound].forEach((el) =>
          el?.classList.add('hidden')
        );
      }

      async function checkStatus(waNumber: string) {
        if (!waNumber) return;
        hideAll();
        loading?.classList.remove('hidden');

        try {
          const res = await fetch(`${API_URL}/api/peserta/status?wa=${encodeURIComponent(waNumber)}`);
          loading?.classList.add('hidden');

          if (res.status === 404) {
            resultNotFound?.classList.remove('hidden');
            return;
          }

          if (!res.ok) {
            throw new Error('Gagal memeriksa status');
          }

          const data = await res.json();

          switch (data.status) {
            case 'menunggu':
              if (namaMenunggu) namaMenunggu.textContent = data.nama;
              resultMenunggu?.classList.remove('hidden');
              break;
            case 'dikonfirmasi':
              if (pesertaNama) pesertaNama.textContent = data.nama;
              if (pesertaInstansi) pesertaInstansi.textContent = data.instansi ? `Asal: ${data.instansi}` : '';
              if (qrImage) qrImage.src = `${API_URL}/api/peserta/qr/${data.qr_token}`;
              if (qrTokenDisplay) qrTokenDisplay.textContent = `Token: ${data.qr_token}`;
              resultDikonfirmasi?.classList.remove('hidden');
              break;
            case 'hadir':
              if (namaHadir) namaHadir.textContent = data.nama;
              resultHadir?.classList.remove('hidden');
              break;
            case 'ditolak':
              if (alasanTolak) alasanTolak.textContent = data.alasan_tolak ? `Catatan: ${data.alasan_tolak}` : 'Tidak memenuhi kualifikasi';
              resultDitolak?.classList.remove('hidden');
              break;
            default:
              resultNotFound?.classList.remove('hidden');
          }
        } catch (err) {
          loading?.classList.add('hidden');
          resultNotFound?.classList.remove('hidden');
        }
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = inputWA.value.trim();
        if (!val) {
          showToast('Harap masukkan nomor WhatsApp yang terdaftar untuk memeriksa status.', 'Nomor WhatsApp Wajib Diisi');
          return;
        }

        // Update URL tanpa reload
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('wa', val);
        window.history.pushState({}, '', newUrl.toString());
        checkStatus(val);
      });

      downloadQR?.addEventListener('click', async () => {
        if (!qrImage) return;
        try {
          const response = await fetch(qrImage.src);
          const blob = await response.blob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `tiket-qr-${pesertaNama?.textContent?.replace(/\s+/g, '-').toLowerCase() || 'acara'}.png`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          window.URL.revokeObjectURL(url);
        } catch (err) {
          window.open(qrImage.src, '_blank');
        }
      });

      // Auto-search jika ada parameter ?wa=... di URL
      const urlParams = new URLSearchParams(window.location.search);
      const waParam = urlParams.get('wa');
      if (waParam) {
        inputWA.value = waParam;
        checkStatus(waParam);
      }
    }

    // Jalankan baik pada load pertama maupun transisi halaman SPA Astro
    document.addEventListener('astro:page-load', initStatusPage);
  </script>
</Layout>
