---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pendaftaran Berhasil Terkirim">
  <section class="py-16 px-4">
    <div class="max-w-lg mx-auto text-center">
      <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 p-8 sm:p-10">
        <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-3xl flex items-center justify-center mx-auto mb-6 text-3xl shadow-inner">
          ✓
        </div>

        <span class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 rounded-full text-xs font-semibold uppercase tracking-wider mb-2">
          Pendaftaran Diterima
        </span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
          Alhamdulillah, Berhasil!
        </h1>
        <p class="text-slate-600 text-sm leading-relaxed mb-6">
          Data dan bukti Anda telah berhasil tersimpan di sistem. Saat ini panitia sedang memverifikasi kelengkapan berkas Anda.
        </p>

        <!-- Information Box -->
        <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200/70 text-left space-y-3 mb-8">
          <div class="flex items-start gap-3">
            <span class="text-lg">📱</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Notifikasi WhatsApp</h3>
              <p class="text-xs text-slate-500 mt-0.5">
                Panitia akan mengirimkan konfirmasi langsung ke nomor WhatsApp Anda.
              </p>
            </div>
          </div>
          <div class="flex items-start gap-3 border-t border-slate-200/60 pt-3">
            <span class="text-lg">🔲</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Cek Status & Unduh QR Mandiri</h3>
              <p class="text-xs text-slate-500 mt-0.5">
                Anda juga dapat melihat status dan mengunduh QR Code kehadiran sendiri kapan saja.
              </p>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="space-y-3">
          <a
            id="btnCekStatus"
            href="/status"
            class="block w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-3.5 px-6 rounded-xl transition duration-150 shadow-md shadow-primary-600/20 text-sm"
          >
            Cek Status Pendaftaran Saya
          </a>
          <a
            href="/"
            class="block w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3 px-6 rounded-xl transition duration-150 text-sm"
          >
            Kembali ke Beranda Acara
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const wa = params.get('wa');
    if (wa) {
      const btn = document.getElementById('btnCekStatus') as HTMLAnchorElement;
      if (btn) {
        btn.href = `/status?wa=${encodeURIComponent(wa)}`;
      }
    }
  </script>
</Layout>
